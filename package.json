{
  "name": "@bitbonsai/mcpvault",
  "version": "0.18.4",
  "description": "Universal AI bridge for Obsidian vaults - connect any MCP-compatible assistant",
  "homepage": "https://mcpvault.org",
  "author": "bitbonsai",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "mcpvault": "dist/server.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun server.ts",
    "build": "bun node_modules/typescript/bin/tsc --project tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "gray-matter": "4.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbonsai/mcpvault.git"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "model-context-protocol",
    "universal",
    "ai-bridge",
    "mcp-server",
    "claude",
    "chatgpt",
    "ai",
    "knowledge-management",
    "pkm",
    "vault",
    "notes",
    "markdown",
    "future-proof",
    "open-standard"
  ],
  "trustedDependencies": [],
